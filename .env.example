EVOAGENT_HOST=127.0.0.1
EVOAGENT_PORT=8080
EVOAGENT_DB_PATH=evoagent.db
EVOAGENT_MAX_DIFF_BYTES=1048576
EVOAGENT_MAX_STEPS=8
EVOAGENT_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
EVOAGENT_AUTH_REQUIRED=false
EVOAGENT_AUTH_SECRET=
EVOAGENT_BOOTSTRAP_ADMIN_USERNAME=
EVOAGENT_BOOTSTRAP_ADMIN_PASSWORD=
EVOAGENT_DEFAULT_TENANT_ID=default
EVOAGENT_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
EVOAGENT_LLM_PROVIDER=local

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
EVOAGENT_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
EVOAGENT_OPENROUTER_API_KEY=
EVOAGENT_OPENROUTER_SITE_URL=
EVOAGENT_OPENROUTER_APP_NAME=EvoAgent

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
EVOAGENT_LLM_BASE_URL=
EVOAGENT_LLM_API_KEY=
EVOAGENT_LLM_MODEL=

# Governed model gateway. Hosts are exact DNS names (no wildcard). An empty
# allowlist trusts only the host selected by the configured route.
EVOAGENT_LLM_ALLOWED_HOSTS=
EVOAGENT_LLM_MAX_INPUT_TOKENS=120000
EVOAGENT_LLM_MAX_OUTPUT_TOKENS=4096
# Budgets are enforced per tenant/repository/UTC day. Zero disables a limit.
EVOAGENT_LLM_DAILY_TOKEN_BUDGET=0
# Cost values use micro currency units (1 whole unit = 1,000,000 micros).
EVOAGENT_LLM_DAILY_COST_MICROS=0
EVOAGENT_LLM_INPUT_COST_MICROS_PER_MILLION=0
EVOAGENT_LLM_OUTPUT_COST_MICROS_PER_MILLION=0

# Replay evaluation and evolution activation gate
EVOAGENT_EVAL_MAX_CASES=5
EVOAGENT_EVAL_MIN_CASES=3
EVOAGENT_EVAL_MIN_HOLDOUT_CASES=2
EVOAGENT_EVAL_MIN_IMPROVEMENT=0.01
EVOAGENT_EVAL_MAX_METRIC_REGRESSION=0

# GitHub integration
EVOAGENT_GITHUB_WEBHOOK_SECRET=
EVOAGENT_GITHUB_TOKEN=
EVOAGENT_AUTO_POST_REVIEW=false
EVOAGENT_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
EVOAGENT_DATABASE_URL=
EVOAGENT_REDIS_URL=
EVOAGENT_ASYNC_WORKERS=2
EVOAGENT_QUEUE_MAX_ATTEMPTS=3
EVOAGENT_QUEUE_LEASE_SECONDS=60
EVOAGENT_QUEUE_SHUTDOWN_TIMEOUT_SECONDS=30
EVOAGENT_OUTBOX_POLL_SECONDS=0.25
EVOAGENT_OUTBOX_BATCH_SIZE=50
EVOAGENT_OUTBOX_LEASE_SECONDS=30
EVOAGENT_OUTBOX_MAX_ATTEMPTS=20
EVOAGENT_EFFECT_LEASE_SECONDS=300
EVOAGENT_SKILLS_DIR=skills
EVOAGENT_SKILL_SANDBOX=true
EVOAGENT_SKILL_TIMEOUT_SECONDS=30
EVOAGENT_SKILL_MEMORY_MB=256
EVOAGENT_SKILL_SIGNING_KEY=

# Trusted in-process infrastructure/workflow plugins. Discovery is opt-in and
# every entry-point id must be allowlisted. Untrusted review logic uses Skills.
EVOAGENT_PLUGIN_PROFILE=
EVOAGENT_PLUGIN_DISCOVERY=false
EVOAGENT_PLUGIN_ALLOWLIST=

# Repair verification and observability
EVOAGENT_REPAIR_TEST_COMMAND=
EVOAGENT_REPAIR_VERIFY_TIMEOUT_SECONDS=120
# Container image for isolated repair verification (recommended for untrusted PR code).
# When empty, verification falls back to host mode with rlimits but no network isolation.
EVOAGENT_REPAIR_CONTAINER_IMAGE=
EVOAGENT_REPAIR_MEMORY_MB=1024
EVOAGENT_REPAIR_PIDS_LIMIT=256
EVOAGENT_REPAIR_CPUS=1.0
# Refuse host-mode verification entirely (fail closed) when no container image is set.
EVOAGENT_REPAIR_REQUIRE_CONTAINER=false
EVOAGENT_REPAIR_MAX_OUTPUT_BYTES=16000
EVOAGENT_OTEL_ENDPOINT=
EVOAGENT_OTEL_SERVICE_NAME=evoagent
EVOAGENT_ALERT_FAILURE_RATE=0.20
EVOAGENT_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
EVOAGENT_GITHUB_APP_ID=
EVOAGENT_GITHUB_APP_SLUG=
EVOAGENT_GITHUB_PRIVATE_KEY_PATH=
EVOAGENT_PUBLIC_BASE_URL=http://127.0.0.1:8080
