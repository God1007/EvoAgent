EVOAGENT_HOST=127.0.0.1
EVOAGENT_PORT=8080
# Boolean values accept only true/false, yes/no, on/off or 1/0.
EVOAGENT_DATABASE_URL=postgresql://evoagent:password@127.0.0.1:5432/evoagent
EVOAGENT_PG_POOL_MIN=1
EVOAGENT_PG_POOL_MAX=10
# Bounds both pool checkout and native PostgreSQL connection setup.
EVOAGENT_PG_POOL_TIMEOUT=10
# Native PostgreSQL statement timeout for every runtime and migration query.
EVOAGENT_PG_STATEMENT_TIMEOUT_SECONDS=120
EVOAGENT_MAX_DIFF_BYTES=1048576
# Maximum compressed GitHub archive and indexed Python source bytes used only
# when the selected workflow explicitly connects repository evidence.
EVOAGENT_REPOSITORY_EVIDENCE_MAX_BYTES=33554432
EVOAGENT_MAX_STEPS=8
EVOAGENT_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
EVOAGENT_AUTH_REQUIRED=false
EVOAGENT_AUTH_SECRET=
# Temporary overlap only: remove after old sessions and OAuth states expire.
EVOAGENT_AUTH_PREVIOUS_SECRET=
# First-start only. Remove both values after the initial administrator can log in.
EVOAGENT_BOOTSTRAP_ADMIN_USERNAME=
EVOAGENT_BOOTSTRAP_ADMIN_PASSWORD=
# Stable 1-200 character identifier; surrounding whitespace is rejected.
EVOAGENT_DEFAULT_TENANT_ID=default
EVOAGENT_SESSION_TTL_SECONDS=3600

# Forwarded client addresses are ignored unless the direct socket peer belongs
# to one of these canonical CIDRs. Never use 0.0.0.0/0 or ::/0.
EVOAGENT_TRUSTED_PROXY_CIDRS=

# Admission control. Tune these starting limits from measured traffic and latency.
# Zero is allowed only for loopback development; burst=0 reuses the RPS value.
EVOAGENT_RATE_LIMIT_RPS=20
EVOAGENT_RATE_LIMIT_BURST=40
EVOAGENT_MAX_INFLIGHT_HEAVY=4
EVOAGENT_MAX_HTTP_CONNECTIONS=128
# Durable per-tenant outstanding-review limit across all database-sharing replicas.
EVOAGENT_TENANT_MAX_ACTIVE_REVIEWS=100
EVOAGENT_TENANT_CAPACITY_RETRY_SECONDS=5

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
EVOAGENT_LLM_PROVIDER=local

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
EVOAGENT_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
EVOAGENT_OPENROUTER_API_KEY=
EVOAGENT_OPENROUTER_SITE_URL=
EVOAGENT_OPENROUTER_APP_NAME=EvoAgent

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
EVOAGENT_LLM_BASE_URL=
EVOAGENT_LLM_API_KEY=
EVOAGENT_LLM_MODEL=

# Governed model gateway. Hosts are exact DNS names (no wildcard). An empty
# allowlist trusts only the host selected by the configured route.
EVOAGENT_LLM_ALLOWED_HOSTS=
EVOAGENT_LLM_MAX_INPUT_TOKENS=120000
EVOAGENT_LLM_MAX_OUTPUT_TOKENS=4096
# Optional single-route TOML. When set, it replaces the provider preset above.
EVOAGENT_LLM_ROUTES_FILE=

# Replay evaluation and candidate qualification gate
EVOAGENT_EVAL_MAX_CASES=5
EVOAGENT_EVAL_MIN_CASES=3
EVOAGENT_EVAL_MIN_HOLDOUT_CASES=2
EVOAGENT_EVAL_MIN_IMPROVEMENT=0.01
EVOAGENT_EVAL_MAX_METRIC_REGRESSION=0

# GitHub integration
EVOAGENT_GITHUB_WEBHOOK_SECRET=
# Outside loopback, configured current/previous Webhook secrets must each contain
# at least 32 bytes; generate high-entropy values in the secret manager.
# Temporary overlap only: remove after GitHub deliveries use the current secret.
EVOAGENT_GITHUB_WEBHOOK_PREVIOUS_SECRET=
EVOAGENT_GITHUB_TOKEN=
# Loopback accepts the token above; non-loopback Webhook intake requires the
# complete tenant-bound GitHub App and installation OAuth configuration below.
EVOAGENT_AUTO_POST_REVIEW=false
EVOAGENT_WEBHOOK_MAX_AGE_SECONDS=600

# Redis is optional; an empty URL uses the in-process development queue.
EVOAGENT_REDIS_URL=
# Per-process thread pool; scale replicas instead of exceeding 256 workers.
EVOAGENT_ASYNC_WORKERS=2
EVOAGENT_QUEUE_MAX_ATTEMPTS=3
EVOAGENT_QUEUE_LEASE_SECONDS=60
EVOAGENT_QUEUE_SHUTDOWN_TIMEOUT_SECONDS=30
EVOAGENT_SHUTDOWN_GRACE_SECONDS=0
EVOAGENT_OUTBOX_POLL_SECONDS=0.25
EVOAGENT_OUTBOX_BATCH_SIZE=50
EVOAGENT_OUTBOX_LEASE_SECONDS=30
EVOAGENT_OUTBOX_MAX_ATTEMPTS=20
EVOAGENT_EFFECT_LEASE_SECONDS=300
# Operational-history deletion is opt-in. Approve policy/backups before setting days > 0.
EVOAGENT_HISTORY_RETENTION_DAYS=0
EVOAGENT_HISTORY_MAINTENANCE_SECONDS=3600
# Bounds trace-event rows and session turns per transaction; one turn may contain many findings.
EVOAGENT_HISTORY_PRUNE_BATCH_SIZE=1000
EVOAGENT_SKILLS_DIR=skills
EVOAGENT_SKILL_SANDBOX=true
EVOAGENT_SKILL_TIMEOUT_SECONDS=30
EVOAGENT_SKILL_MEMORY_MB=256
# Required when container-required mode loads dynamic Skills.
EVOAGENT_SKILL_SIGNING_KEY=
# Use an EvoAgent application image containing /app/evoagent/skill_runner.py.
# It must already exist in the Docker daemon available to EvoAgent.
EVOAGENT_SKILL_CONTAINER_IMAGE=
# May be false only for loopback development; exposed listeners fail closed.
EVOAGENT_SKILL_REQUIRE_CONTAINER=false

# Required for repair publication. Empty keeps review/proof available but makes
# deterministic repair safely abstain before reading or writing GitHub state.
EVOAGENT_REPAIR_TEST_COMMAND=
EVOAGENT_REPAIR_VERIFY_TIMEOUT_SECONDS=120
# Preloaded container image for isolated repair verification. Startup resolves
# it to an immutable local image ID. Direct repair/Proof execution fails closed
# when empty; the separate Proof socket below is an alternative for Proof only.
# Neither path falls back to the host or pulls an image during execution.
EVOAGENT_REPAIR_CONTAINER_IMAGE=
EVOAGENT_REPAIR_MEMORY_MB=1024
EVOAGENT_REPAIR_PIDS_LIMIT=256
EVOAGENT_REPAIR_CPUS=1.0
EVOAGENT_REPAIR_MAX_OUTPUT_BYTES=16000

# Optional dedicated Proof service; empty uses the existing local container adapter.
# See docker-compose.proof.yml and docs/operations.md#dedicated-proof-executor.
# Only the trusted executor receives the dedicated Docker daemon socket; the Web
# process receives this filesystem-protected Unix socket, never the Docker socket.
# This does not enable automatic repair publication or remote dynamic Skills.
EVOAGENT_PROOF_EXECUTOR_SOCKET=
# Compose opt-in only: preloaded sandbox image and Docker socket GID on daemon host.
EVOAGENT_PROOF_IMAGE=
EVOAGENT_DOCKER_SOCKET_GID=

EVOAGENT_OTEL_ENDPOINT=
EVOAGENT_OTEL_SERVICE_NAME=evoagent
EVOAGENT_ALERT_FAILURE_RATE=0.20
EVOAGENT_ALERT_MIN_SAMPLES=10

# `evoagent-slo` operational CLI only. Outside loopback, pass the exact host via
# `--allowed-host`; bearer credentials stay in the environment/secret manager.
EVOAGENT_PROMETHEUS_URL=http://127.0.0.1:9090
EVOAGENT_PROMETHEUS_BEARER_TOKEN=

# GitHub App self-service installation. Configure GitHub's Setup URL as
# https://YOUR_HOST/github/setup and OAuth Callback URL as the exact value below.
# App ID and private-key path must be configured together.
EVOAGENT_GITHUB_APP_ID=
EVOAGENT_GITHUB_APP_SLUG=
EVOAGENT_GITHUB_PRIVATE_KEY_PATH=
EVOAGENT_GITHUB_CLIENT_ID=
EVOAGENT_GITHUB_CLIENT_SECRET=
EVOAGENT_GITHUB_OAUTH_CALLBACK_URL=
